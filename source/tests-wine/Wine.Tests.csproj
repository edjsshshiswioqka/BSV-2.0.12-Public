<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <Compile Include="../GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="../WineRules.cs" Link="WineRules.cs" />
    <Compile Include="../WineData.cs" Link="WineData.cs" />
    <Compile Include="../GrapeWineFeature.cs" Link="GrapeWineFeature.cs" />
    <Reference Include="StardewValley.GameData"><HintPath>$(GamePath)/StardewValley.GameData.dll</HintPath></Reference>
    <Reference Include="MonoGame.Framework"><HintPath>$(GamePath)/MonoGame.Framework.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath Condition="Exists('$(GamePath)/Newtonsoft.Json.dll')">$(GamePath)/Newtonsoft.Json.dll</HintPath>
      <HintPath Condition="!Exists('$(GamePath)/Newtonsoft.Json.dll')">$(GamePath)/smapi-internal/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
